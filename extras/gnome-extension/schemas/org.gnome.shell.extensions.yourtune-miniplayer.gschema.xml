<?xml version="1.0" encoding="UTF-8"?>
<schemalist>
  <schema id="org.gnome.shell.extensions.yourtune-miniplayer" path="/org/gnome/shell/extensions/yourtune-miniplayer/">
    <key name="host" type="s">
      <default>'127.0.0.1'</default>
      <summary>API Server host</summary>
    </key>
    <key name="port" type="i">
      <range min="1" max="65535"/>
      <default>26538</default>
      <summary>API Server port</summary>
    </key>
    <key name="token" type="s">
      <default>''</default>
      <summary>Access token issued by YourTune</summary>
      <description>Cleared when YourTune rejects it, so the panel asks for access again.</description>
    </key>
  </schema>
</schemalist>
